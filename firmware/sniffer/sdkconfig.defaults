# Sniffer build config (target-agnostic: works on classic ESP32 or ESP32-S3).
# Console stays on UART0 (the default), so the JSON stream appears over the
# board's UART bridge (CP2102 or CH343) as a COM port on the PC.
#
# Disable the brownout detector: the RF power-up current spike can reset the
# board on a marginal USB supply, and a sniffer is receive-only, so this is safe.
CONFIG_ESP_BROWNOUT_DET=n
