# ---- ESP-IDF build artifacts (regenerable, large) ----
**/build/
**/managed_components/
**/sdkconfig.old
**/dependencies.lock

# ---- Python ----
**/.venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/

# ---- Trained models (regenerable) ----
watcher/models/*.joblib

# ---- Raw flash dumps / captures (MAY CONTAIN SECRETS, large) ----
experiments/*.bin
*.bin

# ---- OS / editor ----
Thumbs.db
.DS_Store
*.swp

# ---- Logs ARE versioned (reproducers can read the raw results) ----
# raw captures, per-run summaries and demo transcripts live in experiments/ and are committed.
# Only large binary flash dumps (*.bin) and the runtime portal flag stay out.
gateway/*.flag
